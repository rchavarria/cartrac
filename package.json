{
  "name": "cartrac",
  "version": "0.1.0",
  "description": "Track grocery's shopping cart over time",
  "type": "module",
  "bin": {
    "cartrac": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rchavarria/cartrac.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rchavarria/cartrac/issues"
  },
  "homepage": "https://github.com/rchavarria/cartrac#readme",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
